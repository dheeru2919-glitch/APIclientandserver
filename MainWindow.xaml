<Window x:Class="Call_your_existing_Patient_API.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Call_your_existing_Patient_API"
        mc:Ignorable="d"
        Title="Patient Directory" Height="620" Width="1050"
        Background="#F4F7FB"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Height" Value="42" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#2563EB" />
        </Style>
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#0F766E" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#C2414B" />
        </Style>
        <Style x:Key="UpdateButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#B45309" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#172033" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE" />
                    <Setter Property="Foreground" Value="#1E3A8A" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="Patient Directory"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#172033" />
            <TextBlock Text="Manage patient records from your connected API"
                       Margin="0,4,0,0"
                       FontSize="14"
                       Foreground="#64748B" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Load Patients"
                    Width="155"
                    Margin="0,0,8,0"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding LoadPatientsCommand}" />
            <Button Content="Add Patient"
                    Width="135"
                    Margin="0,0,8,0"
                    Style="{StaticResource SuccessButton}"
                    Command="{Binding AddPatientCommand}" />
            <Button Content="Delete Patient"
                    Width="145"
                    Margin="0,0,8,0"
                    Style="{StaticResource DangerButton}"
                    Command="{Binding DeletePatientCommand}" />
                <Button Content="Update Patient"
                    Width="150"
                    Style="{StaticResource UpdateButton}"
                    Command="{Binding UpdatePatientCommand}" />
        </StackPanel>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18"
                Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Add a patient"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#172033"
                           Margin="0,0,0,12" />
                <StackPanel Orientation="Horizontal">
            <StackPanel Margin="0,0,8,0">
                <Label Content="ID (optional)" Padding="0" Foreground="#475569" />
                <TextBox Width="90" Text="{Binding PatientId, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="0,0,8,0">
                <Label Content="Name" Padding="0" Foreground="#475569" />
                <TextBox Width="150" Text="{Binding PatientName, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="0,0,8,0">
                <Label Content="Age" Padding="0" Foreground="#475569" />
                <TextBox Width="70" Text="{Binding PatientAge, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="0,0,8,0">
                <Label Content="Gender" Padding="0" Foreground="#475569" />
                <ComboBox Width="100"
                          SelectedValue="{Binding PatientGender, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="Content">
                    <ComboBoxItem Content="Male" />
                    <ComboBoxItem Content="Female" />
                </ComboBox>
            </StackPanel>
            <StackPanel>
                <Label Content="City" Padding="0" Foreground="#475569" />
                <TextBox Width="150" Text="{Binding PatientCity, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
                </StackPanel>
                <Separator Margin="0,14,0,10" />
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,8,0">
                        <Label Content="Update ID" Padding="0" Foreground="#475569" />
                        <TextBox Width="90" Text="{Binding UpdatePatientId, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel>
                        <Label Content="New City" Padding="0" Foreground="#475569" />
                        <ComboBox Width="180"
                                  ItemsSource="{Binding ExistingCities}"
                                  SelectedItem="{Binding UpdateCity, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3"
                   Margin="0,0,0,8"
                   Foreground="Firebrick"
                   FontWeight="DemiBold"
                   Text="{Binding ErrorMessage}" />

        <DataGrid x:Name="PatientDataGrid"
                  Grid.Row="4"
                  ItemsSource="{Binding Patients}"
                  SelectedItem="{Binding SelectedPatient, Mode=TwoWay}"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E2E8F0"
                  RowBackground="White"
                  AlternatingRowBackground="#F8FAFC"
                  BorderBrush="#CBD5E1"
                  BorderThickness="1"
                  RowHeight="42"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  FontSize="14"
                  Margin="0" />
    </Grid>
</Window>
